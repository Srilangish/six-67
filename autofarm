local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local VirtualUser = game:GetService("VirtualUser")
local CoreGui = game:GetService("CoreGui")
local Lighting = game:GetService("Lighting")
local HttpService = game:GetService("HttpService")
local player = Players.LocalPlayer

-- Apply FPS Cap
pcall(function()
    if setfpscap and Config.FPSRate and Config.FPSRate > 0 then
        setfpscap(Config.FPSRate)
    end
end)

-- Apply Black Textures if enabled
if Config.BlackTextures then
    pcall(function()
        for _, v in ipairs(Lighting:GetChildren()) do
            v:Destroy()
        end
        Lighting.GlobalShadows = false
        Lighting.FogEnd = 9e9
        for _, part in ipairs(workspace:GetDescendants()) do
            if part:IsA("BasePart") then
                part.Material = Enum.Material.SmoothPlastic
                part.Color = Color3.fromRGB(20, 20, 20)
            end
        end
    end)
end

local character, humanoid, root
local function setupCharacter(newChar)
    character = newChar
    humanoid = newChar:WaitForChild("Humanoid")
    root = newChar:WaitForChild("HumanoidRootPart")
end
if player.Character then
    setupCharacter(player.Character)
end
player.CharacterAdded:Connect(setupCharacter)

local HOLD_TIME = 4
local HOLD_COUNT = 2
local STAY_AFTER = 2
local MONEYDROP_RADIUS = 55
local DELAY_BETWEEN_TARGETS = 0.35
local VOID_Y = 500

local startDHC = 0
local visitedCount = 0

-- ==================== WEBHOOK FUNCTION ====================
local function sendWebhook(titleText, description)
    if not Config.WebhookURL or Config.WebhookURL == "" then return end
    local data = {
        embeds = {{
            title = titleText,
            description = description,
            color = 65280,
            footer = {text = "Srilangish Farm • " .. os.date("%X")}
        }}
    }
    pcall(function()
        local req = (syn and syn.request) or (http and http.request) or http_request or request
        if req then
            req({
                Url = Config.WebhookURL,
                Method = "POST",
                Headers = {["Content-Type"] = "application/json"},
                Body = HttpService:JSONEncode(data)
            })
        end
    end)
end

