-- ==================== FARM LOGIC ====================
local function getDHC()
    local df = player:FindFirstChild("DataFolder")
    if df then
        local c = df:FindFirstChild("Currency")
        if c then return c.Value end
    end
    return 0
end

task.spawn(function()
    task.wait(1.5)
    startDHC = getDHC()
end)

RunService.RenderStepped:Connect(function()
    local earned = getDHC() - startDHC
    InfoButton.Text = "DHC: $" .. earned
end)

pcall(function()
    player.CameraMaxZoomDistance = 9999
    player.CameraMinZoomDistance = 0.5
end)

local function findCombatInInventory()
    if character then
        for _, tool in ipairs(character:GetChildren()) do
            if tool:IsA("Tool") and (tool.Name:lower():find("combat") or tool.Name == "[Combat]") then
                return tool
            end
        end
    end
    local backpack = player:FindFirstChild("Backpack")
    if backpack then
        for _, tool in ipairs(backpack:GetChildren()) do
            if tool:IsA("Tool") and (tool.Name:lower():find("combat") or tool.Name == "[Combat]") then
                return tool
            end
        end
    end
    return nil
end

local function equipCombat()
    local combat = findCombatInInventory()
    if combat and humanoid then
        if combat.Parent ~= character then
            humanoid:EquipTool(combat)
        end
        return true
    end
    return false
end

local function holdScreenClick(duration, targetPart)
    local start = tick()
    
    -- Engage VirtualUser click hold
    pcall(function()
        VirtualUser:CaptureController()
        VirtualUser:Button1Down(Vector2.new(), workspace.CurrentCamera.CFrame)
    end)

    while tick() - start < duration do
        if not character or not humanoid or humanoid.Health <= 0 or not root or not root.Parent then break end
        
        local targetCFrame = targetPart.CFrame * CFrame.new(0, 0, -3) * CFrame.Angles(0, math.rad(180), 0)
        root.CFrame = targetCFrame
        root.AssemblyLinearVelocity = Vector3.zero
        root.AssemblyAngularVelocity = Vector3.zero
        
        equipCombat()
        
        -- Keep VirtualUser holding down
        pcall(function()
            VirtualUser:Button1Down(Vector2.new(), workspace.CurrentCamera.CFrame)
        end)
        RunService.Heartbeat:Wait()
    end

    -- Release VirtualUser click
    pcall(function()
        VirtualUser:Button1Up(Vector2.new(), workspace.CurrentCamera.CFrame)
    end)
end

-- Checks if a model named CA$HIER/CA$HIERS has an 'Open' part inside it and no 'Open' part outside
local function isTargetValid(obj)
    if not obj or not obj.Parent or not obj:IsA("Model") then return false end
    
    local name = obj.Name
    if name ~= "CA$HIER" and name ~= "CA$HIERS" then
        return false
    end

    local part = obj.PrimaryPart or obj:FindFirstChildWhichIsA("BasePart")
    if not part or not part.Parent or not part:IsDescendantOf(workspace) then return false end

    -- Must have an "Open" part inside the cashier model
    local hasOpenInside = false
    for _, desc in ipairs(obj:GetDescendants()) do
        if desc.Name == "Open" then
            hasOpenInside = true
            break
        end
    end

    if not hasOpenInside then
        return false
    end

    -- Skip if an "Open" part is sticking out externally near this cashier in the workspace
    for _, descendant in ipairs(workspace:GetDescendants()) do
        if descendant.Name == "Open" and descendant:IsA("BasePart") and not descendant:IsDescendantOf(obj) then
            if (descendant.Position - part.Position).Magnitude <= 6 then
                return false
            end
        end
    end

    if obj:GetAttribute("Broken") or obj:GetAttribute("Destroyed") then return false end
    if part.Transparency >= 0.9 then return false end
    return true
end

local function attackTarget(model)
    local targetPart = model:IsA("BasePart") and model or (model.PrimaryPart or model:FindFirstChildWhichIsA("BasePart"))
    if not targetPart then return end

    for hold = 1, HOLD_COUNT do
        if not humanoid or humanoid.Health <= 0 then break end
        if not isTargetValid(model) then break end

        root.CFrame = targetPart.CFrame * CFrame.new(0, 0, -3) * CFrame.Angles(0, math.rad(180), 0)
        root.AssemblyLinearVelocity = Vector3.zero
        root.AssemblyAngularVelocity = Vector3.zero

        holdScreenClick(HOLD_TIME, targetPart)
        task.wait(0.1)
    end

    local stayStart = tick()
    while tick() - stayStart < STAY_AFTER do
        if not character or not humanoid or humanoid.Health <= 0 or not root or not root.Parent then break end
        if not isTargetValid(model) then break end
        
        root.CFrame = targetPart.CFrame * CFrame.new(0, 0, -3) * CFrame.Angles(0, math.rad(180), 0)
        root.AssemblyLinearVelocity = Vector3.zero
        root.AssemblyAngularVelocity = Vector3.zero
        
        RunService.Heartbeat:Wait()
    end
end

local function clickMoneyDrops()
    if not root or not root.Parent then return end
    for _, obj in ipairs(workspace:GetDescendants()) do
        if obj.Name == "MoneyDrop" then
            local part = obj:IsA("BasePart") and obj or (obj.PrimaryPart or obj:FindFirstChildWhichIsA("BasePart"))
            if part and (part.Position - root.Position).Magnitude <= MONEYDROP_RADIUS then
                for i = 1, 3 do
                    pcall(function()
                        firetouchinterest(root, part, 0)
                        task.wait(0.015)
                        firetouchinterest(root, part, 1)
                    end)
                    pcall(function()
                        VirtualUser:CaptureController()
                        VirtualUser:ClickButton1(Vector2.new())
                    end)
                    local detector = obj:FindFirstChildOfClass("ClickDetector") or part:FindFirstChildOfClass("ClickDetector")
                    if detector then pcall(fireclickdetector, detector) end
                    local prompt = obj:FindFirstChildOfClass("ProximityPrompt") or part:FindFirstChildOfClass("ProximityPrompt")
                    if prompt then pcall(fireproximityprompt, prompt) end
                    task.wait(0.015)
                end
            end
        end
    end
end

local function getCashiers()
    local list = {}
    for _, obj in ipairs(workspace:GetDescendants()) do
        if isTargetValid(obj) then
            table.insert(list, obj)
        end
    end
    return list
end

RunService.Stepped:Connect(function()
    if humanoid and humanoid.Parent then
        humanoid.Sit = false
        humanoid.PlatformStand = false
    end
end)

local function floatInVoid()
    if not root or not root.Parent then return end
    root.CFrame = CFrame.new(0, VOID_Y, 0)
    root.AssemblyLinearVelocity = Vector3.zero
    root.AssemblyAngularVelocity = Vector3.zero
end

task.spawn(function()
    while true do
        if not character or not humanoid or humanoid.Health <= 0 or not root or not root.Parent then
            task.wait(1)
        elseif not equipCombat() then
            task.wait(0.6)
        else
            local cashiers = getCashiers()
            if #cashiers == 0 then
                floatInVoid()
                task.wait(1.0)
            else
                for _, cashier in ipairs(cashiers) do
                    if not humanoid or humanoid.Health <= 0 then break end
                    if not isTargetValid(cashier) then continue end

                    attackTarget(cashier)

                    for i = 1, 6 do
                        clickMoneyDrops()
                        task.wait(0.1)
                    end

                    visitedCount += 1
                    if visitedCount % 5 == 0 then
                        sendWebhook(
                            "Farm Progress",
                            "**Cashiers Visited:** " .. visitedCount ..
                            "\n**DHC Earned:** $" .. (getDHC() - startDHC)
                        )
                    end

                    floatInVoid()
                    task.wait(1.0)

                    task.wait(DELAY_BETWEEN_TARGETS)
                end
            end
        end
        task.wait(0.2)
    end
end)

task.spawn(function()
    while true do
        if humanoid and humanoid.Health > 0 then
            clickMoneyDrops()
            equipCombat()
        end
        task.wait(0.3)
    end
end)

print("[Srilangish] VirtualUser Cashier Autofarm Loaded")
